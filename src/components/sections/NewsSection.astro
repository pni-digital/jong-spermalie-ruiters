---
interface NewsImage {
    src: string;
    alt: string;
}

interface Article {
    title: string;
    text: string;
    images: NewsImage[];
}

interface Props {
    title: string;
    articles: Article[];
}

const { title, articles } = Astro.props;
---

<section class="news-section" id="nieuws">
    <div class="news-inner">
        <h2 class="news-title">{title}</h2>
        <div class="news-divider"></div>

        <div class="news-articles">
            {articles.map((article, i) => (
                <article class={`news-article ${i % 2 === 1 ? 'news-article--reverse' : ''}`}>
                    <div class="news-images">
                        {article.images.map((img) => (
                            <div class="news-image">
                                <img src={img.src} alt={img.alt} />
                            </div>
                        ))}
                    </div>
                    <div class="news-text">
                        <h3 class="news-article-title">{article.title}</h3>
                        {article.text.split('\n\n').map((paragraph) => (
                            <p class="news-article-text">{paragraph}</p>
                        ))}
                    </div>
                </article>
            ))}
        </div>

        {articles.length <= 1 && (
            <p class="news-coming-soon">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                Meer nieuws wordt weldra toegevoegd.
            </p>
        )}
    </div>
</section>

<style>
    .news-section {
        background: #faf8f5;
        padding: 5rem 0;
        width: 100%;
    }

    .news-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 5%;
    }

    .news-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3vw, 2.8rem);
        font-weight: 700;
        color: #1c1712;
        line-height: 1.2;
        margin: 0 0 0.75rem 0;
    }

    .news-divider {
        width: 40px;
        height: 2px;
        background: #b8924a;
        margin-bottom: 3rem;
    }

    .news-articles {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    .news-article {
        display: flex;
        align-items: center;
        gap: 3rem;
    }

    .news-article--reverse {
        flex-direction: row-reverse;
    }

    .news-images {
        flex: 0 0 42%;
        display: flex;
        gap: 1rem;
    }

    .news-image {
        flex: 1;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: 2px;
    }

    .news-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .news-text {
        flex: 1;
    }

    .news-article-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 600;
        color: #1c1712;
        margin: 0 0 0.75rem 0;
        line-height: 1.25;
    }

    .news-article-text {
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: #4a3f35;
        line-height: 1.8;
        margin: 0 0 1rem 0;
    }

    .news-article-text:last-child {
        margin-bottom: 0;
    }

    .news-coming-soon {
        font-family: 'Inter', sans-serif;
        font-size: 0.82rem;
        color: #a08060;
        font-style: italic;
        margin: 2.5rem 0 0;
        text-align: center;
    }

    @media (max-width: 900px) {
        .news-article,
        .news-article--reverse {
            flex-direction: column;
            gap: 1.5rem;
        }

        .news-images {
            flex: unset;
            width: 100%;
        }
    }

    @media (max-width: 600px) {
        .news-images {
            flex-direction: column;
        }
    }
</style>
