---
interface Download {
    label: string;
    file: string;
    description?: string;
}
interface Props {
    eyebrow?: string;
    title?: string;
    description?: string;
    downloads: Download[];
}
const {
    eyebrow = 'Downloads',
    title = 'Documenten & downloads',
    description = 'Hier vind je alle nuttige documenten terug om de dag voor te bereiden.',
    downloads,
} = Astro.props;

function fileLabel(file: string): string {
    const ext = file.split('.').pop()?.toUpperCase();
    return ext ?? 'PDF';
}
---
{downloads && downloads.length > 0 && (
    <section class="downloads-section">
        <div class="downloads-inner">
            <p class="downloads-eyebrow">{eyebrow}</p>
            <h2 class="downloads-title">{title}</h2>
            <div class="downloads-divider"></div>
            <p class="downloads-description">{description}</p>
            <div class="downloads-grid">
                {downloads.map((dl) => (
                    <a href={dl.file} download class="download-card">
                        <div class="download-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
                        </div>
                        <div class="download-body">
                            <p class="download-label">{dl.label}</p>
                            {dl.description && <p class="download-desc">{dl.description}</p>}
                            <span class="download-meta">{fileLabel(dl.file)} · Download</span>
                        </div>
                        <div class="download-arrow">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
)}

<style>
    .downloads-section {
        background: #faf8f5;
        border-top: 1px solid #b8924a;
        padding: 5rem 0;
    }

    .downloads-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 5%;
    }

    .downloads-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #b8924a;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
    }

    .downloads-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 700;
        color: #1c1712;
        margin: 0 0 0.75rem;
        line-height: 1.2;
    }

    .downloads-divider {
        width: 48px;
        height: 2px;
        background: #b8924a;
        margin-bottom: 1.5rem;
    }

    .downloads-description {
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: #6b5a4e;
        line-height: 1.7;
        max-width: 640px;
        margin: 0 0 2.5rem;
    }

    .downloads-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
    }

    .download-card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.5rem;
        background: #fff;
        border: 1px solid rgba(184, 146, 74, 0.25);
        border-radius: 4px;
        text-decoration: none;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    }

    .download-card:hover {
        border-color: #b8924a;
        box-shadow: 0 8px 24px rgba(184, 146, 74, 0.12);
        transform: translateY(-2px);
    }

    .download-icon {
        color: #b8924a;
        flex-shrink: 0;
        display: flex;
    }

    .download-body {
        flex: 1;
        min-width: 0;
    }

    .download-label {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #1c1712;
        margin: 0 0 0.25rem;
        line-height: 1.25;
    }

    .download-desc {
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        color: #6b5a4e;
        line-height: 1.55;
        margin: 0 0 0.5rem;
    }

    .download-meta {
        font-family: 'Inter', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #b8924a;
    }

    .download-arrow {
        color: #b8924a;
        flex-shrink: 0;
        display: flex;
        transition: transform 0.2s;
    }

    .download-card:hover .download-arrow {
        transform: translateY(2px);
    }

    @media (max-width: 700px) {
        .downloads-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
