---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CountdownSection from '../../../components/countdown/CountdownSection.astro';
import SponsorsSection from '../../../components/sections/SponsorsSection.astro';

const edition = await getEntry('editions', 'ponytornooi-middelkerke/editions/2026');
const home = await getEntry('pages', 'home');
const { sponsors } = home!.data;
---

<BaseLayout title="Ponytornooi Middelkerke 2026">
    {edition && (
        <div class="tornooi-countdown-wrap">
            <CountdownSection
                title={edition.data.title}
                date={edition.data.countdown}
                location={edition.data.location}
                eventSlug="ponytornooi-middelkerke"
            />
        </div>
    )}

    <div class="tornooi-content">
        <div class="tornooi-inner">
            <p class="tornooi-eyebrow">Ponytornooi Middelkerke</p>
            <h1 class="tornooi-title">13 september 2026</h1>
            <div class="tornooi-divider"></div>
            <div class="tornooi-body">
                {edition?.body}
            </div>
        </div>
    </div>

    <section class="praktisch-section">
        <div class="praktisch-inner">
            <p class="praktisch-eyebrow">Praktische info</p>
            <h2 class="praktisch-title">Alles wat je moet weten</h2>
            <div class="praktisch-divider"></div>
            <div class="praktisch-grid">
                <div class="praktisch-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <p class="praktisch-label">Datum</p>
                    <p class="praktisch-value">13 september 2026</p>
                </div>
                <div class="praktisch-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    </div>
                    <p class="praktisch-label">Aanvang</p>
                    <p class="praktisch-value">9:00</p>
                </div>
                <div class="praktisch-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <p class="praktisch-label">Locatie</p>
                    <p class="praktisch-value">
                        Terreinen Snippenhof<br/>
                        Snipgatstraat 9<br/>
                        8432 Leffinge
                    </p>
                    <a
                        href="https://www.google.com/maps/search/?api=1&query=Snipgatstraat+9%2C+8432+Leffinge"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="praktisch-maplink"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        Bekijk op Google Maps
                    </a>
                    <p class="praktisch-sub">Bereikbaar via Oostendebaan – Zwarteweg</p>
                </div>
            </div>

            <div class="praktisch-beleving-grid">
                <div class="beleving-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="6"/><path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"/></svg>
                    </div>
                    <h3 class="beleving-title">Wedstrijden</h3>
                    <p class="beleving-lead">Dressuur &amp; Jumping</p>
                    <ul class="beleving-list">
                        <li>Aanvang om 9u</li>
                        <li>Meer dan 400 pony's en ruiters</li>
                        <li>De hele dag door wedstrijdplezier</li>
                    </ul>
                </div>

                <div class="beleving-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M3 2v7c0 1.1.9 2 2 2h0a2 2 0 0 0 2-2V2"/><path d="M5 2v20"/><path d="M19 2v20"/><path d="M19 11c2 0 2-3 2-5 0-2.5-1-4-2-4"/></svg>
                    </div>
                    <h3 class="beleving-title">Hongertje na de proef?</h3>
                    <p class="beleving-lead">Keuze uit vol-au-vent, stoofvlees of balletjes in tomatensaus</p>
                    <ul class="beleving-list">
                        <li>Ruitersportie (&gt;14j): 18&euro;</li>
                        <li>Ponyportie (6–14j): 14&euro;</li>
                        <li>Shetlandportie (&lt;6j): 10&euro;</li>
                    </ul>
                </div>

                <div class="beleving-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M18.178 8C19.732 8 21 9.343 21 11s-1.268 3-2.822 3c-1.165 0-2.165-.755-2.594-1.834L12 8.5m6.178-.5C16.5 8 15.5 9.5 12 12m6.178 8C19.732 16 21 14.657 21 13"/><path d="M5.822 8C4.268 8 3 9.343 3 11s1.268 3 2.822 3c1.165 0 2.165-.755 2.594-1.834"/></svg>
                    </div>
                    <h3 class="beleving-title">Doorlopend</h3>
                    <p class="beleving-lead">De hele dag te verkrijgen</p>
                    <ul class="beleving-list">
                        <li>Ginbar &amp; Jus de Mer</li>
                        <li>IJsjes</li>
                        <li>Frietjes</li>
                        <li>… en nog veel meer</li>
                    </ul>
                </div>

                <div class="beleving-item">
                    <div class="praktisch-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 11h14l-1.5 9a1 1 0 0 1-1 .85h-9A1 1 0 0 1 6.5 20z"/><path d="M5 11l2-5h10l2 5"/><path d="M12 6V3"/></svg>
                    </div>
                    <h3 class="beleving-title">Tombola</h3>
                    <p class="beleving-lead">Altijd prijs!</p>
                    <ul class="beleving-list">
                        <li>Hoofdprijs: ballonvaart voor 4 personen</li>
                    </ul>
                </div>
            </div>

            <div class="praktisch-kinderdorp">
                <div class="praktisch-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 21V10l2-2 2 2v2h2V8l2-2 2 2v4h2v-2l2-2 2 2v11z"/><path d="M4 21h16"/><path d="M6 8V4l1 1 1-1"/><path d="M16 8V4l1 1 1-1"/></svg>
                </div>
                <p class="praktisch-kinderdorp-text">Ook naast de piste is er heel wat te beleven! Kom spelen, ontdekken en genieten in ons gezellige kinderdorp.</p>
            </div>
        </div>
    </section>

    <section class="terugblik-section">
        <div class="terugblik-header">
            <p class="terugblik-eyebrow">Terugblik</p>
            <h2 class="terugblik-title">Editie 2023</h2>
            <div class="terugblik-divider"></div>
            <p class="terugblik-subtitle">Een dag vol passie, spanning en onvergetelijke momenten op het veld.</p>
        </div>
        <div class="terugblik-grid">
            <div class="terugblik-photo t-tall"><img src="/images/tornooi-2023/FRA_0290b.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1288.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1434.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo t-wide"><img src="/images/tornooi-2023/DJI_0873.jpg" alt="Tornooi 2023 luchtfoto" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1450.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1455.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/sabbe.jpeg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1506.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo t-tall"><img src="/images/tornooi-2023/MAR11627.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1509.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/FRA_1772.JPG" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo t-wide"><img src="/images/tornooi-2023/MAR11747.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/MAR11757.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1768931195091_7419435187295703665.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779913519837_7465498395907423816.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779913724873_7465499255891867550.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/droomboom.jpeg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779913772550_7465499455862919407.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo t-tall"><img src="/images/tornooi-2023/facebook_1779913797503_7465499560524600760.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779913940173_7465500158926745516.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779914002904_7465500422037753098.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo t-wide"><img src="/images/tornooi-2023/IMG-20260131-WA0007.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779914020772_7465500496980112569.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779914036389_7465500562484958118.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/facebook_1779914107959_7465500862671257958.jpg" alt="Tornooi 2023" loading="lazy" /></div>
            <div class="terugblik-photo"><img src="/images/tornooi-2023/84ec95f1-7c0c-4f5b-9a06-3a831cfd63de.jpeg" alt="Tornooi 2023" loading="lazy" /></div>
        </div>
    </section>

    <section class="sponsor-cta-section">
        <div class="sponsor-cta-inner">
            <p class="sponsor-cta-eyebrow">Word partner</p>
            <h2 class="sponsor-cta-title">Ondersteun een prachtig evenement</h2>
            <div class="sponsor-cta-divider"></div>
            <p class="sponsor-cta-text">Wil je dit evenement mee mogelijk maken en je merk verbinden aan een dag vol passie, sport en gemeenschap? Download onze sponsorbrochure en ontdek alle mogelijkheden.</p>
            <a href="/docs/ponytornooi-2026.pdf" download class="sponsor-cta-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download sponsorbrochure
            </a>
        </div>
    </section>

    <SponsorsSection
        eyebrow={sponsors.eyebrow}
        title={sponsors.title}
        description={sponsors.description}
        cta={sponsors.cta}
        logos={sponsors.logos}
        showTier="alle"
    />
</BaseLayout>

<style>
    .tornooi-countdown-wrap {
        padding-top: 80px;
    }

    .tornooi-countdown-wrap :global(.countdown-section) {
        margin-top: 0 !important;
        box-shadow: none !important;
    }

    .tornooi-content {
        background: #faf8f5;
        padding: 5rem 0;
    }

    .tornooi-inner {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 5%;
    }

    .tornooi-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #b8924a;
        text-transform: uppercase;
        margin: 0 0 0.5rem;
    }

    .tornooi-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 700;
        color: #1c1712;
        margin: 0 0 0.75rem;
        line-height: 1.2;
    }

    .tornooi-divider {
        width: 48px;
        height: 2px;
        background: #b8924a;
        margin-bottom: 2rem;
    }

    .tornooi-body {
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        color: #4a3f35;
        line-height: 1.8;
    }

    /* PRAKTISCH SECTIE */
    .praktisch-section {
        background: #f5ede0;
        border-top: 1px solid #b8924a;
        padding: 5rem 0;
    }

    .praktisch-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 5%;
    }

    .praktisch-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #b8924a;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
    }

    .praktisch-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 700;
        color: #1c1712;
        margin: 0 0 0.75rem;
        line-height: 1.2;
    }

    .praktisch-divider {
        width: 48px;
        height: 2px;
        background: #b8924a;
        margin-bottom: 2.5rem;
    }

    .praktisch-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .praktisch-item {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .praktisch-icon {
        color: #b8924a;
        margin-bottom: 0.5rem;
    }

    .praktisch-label {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: #b8924a;
        text-transform: uppercase;
        margin: 0;
    }

    .praktisch-value {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: #1c1712;
        margin: 0;
    }

    .praktisch-notice {
        border-top: 1px solid rgba(184, 146, 74, 0.25);
        padding-top: 2rem;
    }

    .praktisch-notice p {
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        color: #6b5a4e;
        line-height: 1.8;
        font-style: italic;
        max-width: 760px;
    }

    .praktisch-maplink {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.6rem;
        font-family: 'Inter', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #b8924a;
        text-decoration: none;
        transition: gap 0.2s, color 0.2s;
    }

    .praktisch-maplink:hover {
        gap: 0.65rem;
        color: #caa35a;
    }

    .praktisch-sub {
        font-family: 'Inter', sans-serif;
        font-size: 0.8rem;
        color: #6b5a4e;
        margin: 0.75rem 0 0;
        line-height: 1.5;
    }

    /* BELEVING GRID */
    .praktisch-beleving-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin-top: 1rem;
        padding-top: 3rem;
        border-top: 1px solid rgba(184, 146, 74, 0.25);
    }

    .beleving-item {
        background: #faf6ef;
        border: 1px solid rgba(184, 146, 74, 0.2);
        border-radius: 4px;
        padding: 2rem;
    }

    .beleving-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: #1c1712;
        margin: 0.75rem 0 0.25rem;
        line-height: 1.2;
    }

    .beleving-lead {
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: #8a6d3a;
        margin: 0 0 1rem;
        line-height: 1.5;
    }

    .beleving-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .beleving-list li {
        font-family: 'Inter', sans-serif;
        font-size: 0.92rem;
        color: #4a3f35;
        line-height: 1.6;
        padding-left: 1.1rem;
        position: relative;
        margin-bottom: 0.35rem;
    }

    .beleving-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.6rem;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #b8924a;
    }

    /* KINDERDORP */
    .praktisch-kinderdorp {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-top: 2rem;
        padding: 2.5rem;
        background: #1a1108;
        border-radius: 4px;
    }

    .praktisch-kinderdorp .praktisch-icon {
        color: #b8924a;
        margin: 0;
        flex-shrink: 0;
    }

    .praktisch-kinderdorp-text {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.25rem, 2.2vw, 1.75rem);
        font-weight: 600;
        color: #f5f0e8;
        margin: 0;
        line-height: 1.35;
    }

    @media (max-width: 768px) {
        .praktisch-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .praktisch-beleving-grid {
            grid-template-columns: 1fr;
        }
        .praktisch-kinderdorp {
            flex-direction: column;
            text-align: center;
            gap: 1rem;
        }
    }

    @media (max-width: 480px) {
        .praktisch-grid {
            grid-template-columns: 1fr;
        }
    }

    /* TERUGBLIK SECTIE */
    .terugblik-section {
        background: #1a1108;
        padding: 5rem 0 0;
    }

    .terugblik-header {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 5% 3rem;
        text-align: center;
    }

    .terugblik-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #b8924a;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
    }

    .terugblik-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 700;
        color: #f5f0e8;
        margin: 0 0 0.75rem;
        line-height: 1.2;
    }

    .terugblik-divider {
        width: 48px;
        height: 2px;
        background: #b8924a;
        margin: 0 auto 1.25rem;
    }

    .terugblik-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: #8a7a6a;
        line-height: 1.7;
        max-width: 500px;
        margin: 0 auto;
    }

    .terugblik-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 220px;
        gap: 4px;
    }

    .terugblik-photo {
        overflow: hidden;
        background: #0f0a04;
    }

    .terugblik-photo.t-wide {
        grid-column: span 2;
    }

    .terugblik-photo.t-tall {
        grid-row: span 2;
    }

    .terugblik-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform 0.4s ease, filter 0.4s ease;
        filter: brightness(0.85);
    }

    .terugblik-photo:hover img {
        transform: scale(1.05);
        filter: brightness(1);
    }

    @media (max-width: 900px) {
